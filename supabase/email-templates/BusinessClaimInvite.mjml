<mjml>
  <mj-head>
    <mj-title>{{business_name}} is listed on Sound</mj-title>
    <mj-preview>{{business_name}} now has a free profile on Sound. Claim it to reply to reviews.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text color="#000000" font-size="15px" line-height="1.6" padding="0" />
      <mj-button background-color="#000000" color="#ffffff" border-radius="4px" font-weight="700" inner-padding="14px 28px" align="left" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f6f7f9">
    <mj-section background-color="#111111" padding="20px 36px">
      <mj-column>
        <mj-text color="#ffffff" font-size="17px" font-weight="700">Sound</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="36px 36px 8px">
      <mj-column>
        <mj-text font-size="26px" font-weight="700" line-height="1.25">{{business_name}} is now listed on Sound</mj-text>
        <mj-text color="#6b7280" font-size="15px" padding="10px 0 0">A customer added your business to Sound{{area}} so they could review their own experience of your service.</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="24px 36px 8px">
      <mj-column>
        <mj-text font-weight="700" font-size="15px">Your profile is free, and it is yours to claim</mj-text>
        <mj-text padding="8px 0 0">Confirm your ownership and you can describe what you do best, add photos and services, and reply to every review.</mj-text>
        <mj-text padding="8px 0 0">Until you claim it, your profile shows as not yet claimed.</mj-text>
        <mj-text padding="8px 0 0">Rosettes are earned only through verified reviews. No business can pay to remove, hide or reorder a review, and a free listing gives no control over ratings.</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="24px 36px 36px">
      <mj-column>
        <mj-button href="{{cta_url}}">Claim your free profile</mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="#f6f7f9" padding="24px 36px 36px">
      <mj-column>
        <mj-text color="#6b7280" font-size="12px" line-height="1.6">This notice is sent because your business information is publicly available and you offer equestrian services to the public. It explains what is shown about you and your rights under the Protection of Personal Information Act. You can reply to reviews, flag a policy breach, or dispute a factual claim at any time.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>